{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/manifesto", "dest": "/manifesto.html" },
    { "src": "/company", "dest": "/company.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
